<bars:RibbonWindow
    x:Class="CAPlanetSparrowSample.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:CAPlanetSparrowSample.WPF"
    xmlns:local_res="clr-namespace:CAPlanetSparrowSample.WPF.Resources"
    xmlns:local_views="clr-namespace:CAPlanetSparrowSample.WPF.Views"
    xmlns:bars="http://schemas.actiprosoftware.com/winfx/xaml/bars"
    xmlns:docking="http://schemas.actiprosoftware.com/winfx/xaml/docking"
    xmlns:shared="http://schemas.actiprosoftware.com/winfx/xaml/shared"
    xmlns:themes="http://schemas.actiprosoftware.com/winfx/xaml/themes"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance local:MainWindowViewModel}"
    themes:ThemeManager.DesignModeAreNativeThemesEnabled="True"
    themes:ThemeManager.DesignModeTheme="Dark"
    themes:ThemeManager.AreNativeThemesEnabled="True"
    themes:ThemeManager.Theme="Dark"
    Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <DataTemplate DataType="{x:Type local_views:WorkspaceViewModel}">
            <local_views:WorkspaceView />
        </DataTemplate>
    </Window.Resources>
    <themes:WindowChrome.Chrome>
        <themes:RibbonWindowChrome BackdropKind="None" TitleBarHeaderAlignment="Center" />
    </themes:WindowChrome.Chrome>
    <themes:WindowChrome.OverlayContent>
        <Grid Background="#80000000">
            <shared:ShadowChrome HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Elevation="20"/>
        </Grid>
    </themes:WindowChrome.OverlayContent>

    <bars:RibbonContainerPanel>
        <bars:Ribbon x:Name="ribbon"
                     IsApplicationButtonVisible="False"
                     BorderBrush="Transparent"
                     BorderThickness="0"
                     CanChangeLayoutMode="False"
                     GroupLabelMode="Default"
                     IsCollapsed="False"
                     IsCollapsible="False"
                     IsOptionsButtonVisible="False"
                     QuickAccessToolBarMode="None"
                     UserInterfaceDensity="Compact">
            <!--<bars:Ribbon.Resources>
                <Style TargetType="{x:Type bars:RibbonGroup}">
                    <EventSetter Event="Loaded" Handler="RibbonGroup_Loaded" />
                </Style>
            </bars:Ribbon.Resources>-->

            <!--<bars:Ribbon.ApplicationButtonContent>
                <bars:RibbonApplicationButton IsPopupOpen="{Binding Ribbon.IsApplicationMenuOpen, Mode=TwoWay}"
                                              KeyTipText="F">
                    <bars:RibbonApplicationButton.MenuAdditionalContent>
                        <bars:RecentDocumentControl Manager="{Binding Ribbon.RecentDocManager}"
                                                    OpenCommand="{Binding OpenRecentCommand}"
                                                    UseLargeSize="False" />
                    </bars:RibbonApplicationButton.MenuAdditionalContent>
                    <bars:RibbonApplicationButton.MenuFooter>
                        <StackPanel Margin="4"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <bars:BarButton MinWidth="72"
                                            Margin="4"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding ClearRecentCommand}"/>
                        </StackPanel>
                    </bars:RibbonApplicationButton.MenuFooter>
                    <bars:BarMenuItem Command="{Binding NewProjectCommand}"
                                      InputGestureText="Ctrl+N"
                                      KeyTipText="N"
                                      LargeImageSource="{x:Static local_res:PathIconResource.FileImage}"
                                      UseLargeSize="True" />
                    <bars:BarMenuItem Command="{Binding OpenMarkerCommand}"
                                      InputGestureText="Ctrl+O"
                                      KeyTipText="O"
                                      LargeImageSource="{x:Static local_res:PathIconResource.FileImage}"
                                      UseLargeSize="True" />
                    <bars:BarSeparator />
                    <bars:BarMenuItem Command="{Binding SaveAllMarkerCommand}"
                                      InputGestureText="Ctrl+S"
                                      KeyTipText="S"
                                      LargeImageSource="{x:Static local_res:PathIconResource.FileImage}"
                                      UseLargeSize="True" />
                    <bars:BarMenuItem Command="{Binding SaveMarkerCommand}"
                                      LargeImageSource="{x:Static local_res:PathIconResource.FileImage}"
                                      UseLargeSize="True" />
                    <bars:BarMenuItem Command="{Binding SaveAsMarkerCommand}"
                                      LargeImageSource="{x:Static local_res:PathIconResource.FileImage}"
                                      UseLargeSize="True" />
                    <bars:BarSeparator />
                    <bars:BarMenuItem Command="{Binding ExportCutCommand}"
                                      KeyTipText="C"
                                      LargeImageSource="{x:Static local_res:PathIconResource.FileImage}"
                                      UseLargeSize="True" />
                    <bars:BarSeparator />
                    <bars:BarMenuItem Command="{Binding ShowSettingsCommand}"
                                      InputGestureText="Ctrl+K"
                                      KeyTipText="T"
                                      LargeImageSource="{x:Static local_res:PathIconResource.FileImage}"
                                      UseLargeSize="True" />
                    <bars:BarSeparator />
                    <bars:BarMenuItem Command="{Binding ExitCommand}"
                                      LargeImageSource="{x:Static local_res:PathIconResource.FileImage}"
                                      UseLargeSize="True" />
                </bars:RibbonApplicationButton>
            </bars:Ribbon.ApplicationButtonContent>-->

            <bars:RibbonTabItem Label="Home">

                <bars:RibbonGroup Label="Input">
                    <bars:RibbonControlGroup>
                        <bars:BarButton Command="{Binding ProjectOpenCommand}"
                                        Label="Open"
                                        LargeImageSource="{x:Static local_res:PathIconResource.TemplateImage}" />
                        <!--<bars:BarButton Command="{Binding SaveAllMarkerCommand}"
                                        Label="Save All"
                                        LargeImageSource="{x:Static local_res:PathIconResource.FileImage}" />
                        <bars:BarButton Command="{Binding SaveMarkerCommand}"
                                        Label="Save"
                                        LargeImageSource="{x:Static local_res:PathIconResource.FileImage}" />
                        <bars:BarButton Command="{Binding SaveAsMarkerCommand}"
                                        Label="SaveAs"
                                        LargeImageSource="{x:Static local_res:PathIconResource.FileImage}" />-->

                    </bars:RibbonControlGroup>
                </bars:RibbonGroup>

                <bars:RibbonGroup Label="Nesting">
                    <bars:BarButton Command="{Binding StartAllCommand}"
                                    Label="Satrt"
                                    LargeImageSource="{x:Static local_res:PathIconResource.FileImage}" />
                    <bars:BarButton Command="{Binding StopCommand}"
                                    Label="Stop"
                                    LargeImageSource="{x:Static local_res:PathIconResource.PauseImage}" />

                    <bars:BarButton Command="{Binding StartCommand}"
                                    Label="ReStart"
                                    LargeImageSource="{x:Static local_res:PathIconResource.ReNestImage}" />

                </bars:RibbonGroup>
                <bars:RibbonGroup Label="Output">
                    <bars:RibbonControlGroup>
                        <bars:BarButton Command="{Binding ExportCutCommand}"
                                        Label="Export Json"
                                        LargeImageSource="{x:Static local_res:PathIconResource.JsonImage}" />
                    </bars:RibbonControlGroup>

                </bars:RibbonGroup>
            </bars:RibbonTabItem>

            <bars:RibbonTabItem ContextualTabGroupKey="*"
                                KeyTipText="H"
                                Label="Help">
                <bars:RibbonGroup Label="Support">
                    <bars:BarButton Command="{Binding OpenLogFolderCommand}"
                                    Label="Log_folder"
                                    LargeImageSource="{x:Static local_res:PathIconResource.LogOpenImage}" />
                    <bars:BarButton Command="{Binding ShowAboutCommand}"
                                    Label="About"
                                    LargeImageSource="{x:Static local_res:PathIconResource.InformationImage}" />
                </bars:RibbonGroup>
            </bars:RibbonTabItem>



        </bars:Ribbon>


        <Grid>
            <DockPanel>

                <docking:DockSite AreDocumentWindowsDestroyedOnClose="True"
                                  AreNewTabsInsertedBeforeExistingTabs="False"
                                  CanDocumentWindowsFloat="False"
                                  DocumentItemContainerStyle="{StaticResource DockingDocumentWindowStyle}"
                                  DocumentItemTemplate="{StaticResource DockingDocumentItemContentTemplate}"
                                  DocumentItemsSource="{Binding DockSite.DocumentItems}"
                                  Style="{StaticResource DockSiteStyle}">
                    <docking:Workspace Margin="0" Padding="0">
                        <docking:TabbedMdiHost
                            CanDocumentTabsDrag="False"
                            CanDocumentsAttach="False"
                            CanDocumentsCloseOnMiddleClick="False"
                            CanDocumentsDock="False"
                            ContextMenuService.IsEnabled="False"
                            TabStripPlacement="Bottom"
                            />
                    </docking:Workspace>
                </docking:DockSite>                
            </DockPanel>
        </Grid>        
    </bars:RibbonContainerPanel>
</bars:RibbonWindow>
